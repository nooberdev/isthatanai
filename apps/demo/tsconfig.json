{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "#lib": ["./src/lib"],
      "#lib/*": ["./src/lib/*"],
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$lib/components": ["./src/lib/components"],
      "$lib/components/*": ["./src/lib/components/*"],
      "$lib/components/ui": ["./src/lib/components/ui"],
      "$lib/components/ui/*": ["./src/lib/components/ui/*"],
      "$lib/utils": ["./src/lib/utils"],
      "$lib/utils/*": ["./src/lib/utils/*"],
      "$lib/hooks": ["./src/lib/hooks"],
      "$lib/hooks/*": ["./src/lib/hooks/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
